# Copy to .env.local (git-ignored).

# Your LTA DataMall key (free: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html).
# With this set, `npm run dev` proxies live arrivals straight from LTA and
# `npm run data:update` refreshes public/data. It never reaches the browser bundle.
LTA_ACCOUNT_KEY=

# Arrivals proxy for production builds (the Cloudflare Worker in worker/).
# Leave empty to use the dev proxy above, or the community arrivelah API if neither is set.
VITE_ARRIVALS_URL=
